--- a/prototype/index.html
+++ b/prototype/index.html
@@ -276,7 +276,7 @@ const MATS = {
   c21:    { name:'С21',       prof:1, per:0.100, height:0.021 },
   prof:   { name:'НС35',      prof:1, per:0.200, height:0.035 },
